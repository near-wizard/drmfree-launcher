# Optional. Without this set, analytics code runs but has nowhere to
# send events (silent no-op) — the app is fully functional either way.
# PostHog's project API key is public/embeddable by design (not a
# secret, unlike an affiliate tag) — safe to bake into a built app.
# Get it from your PostHog project settings.
VITE_POSTHOG_KEY=

# Defaults to PostHog Cloud US (https://us.i.posthog.com). Only needs
# overriding for EU-hosted or self-hosted PostHog.
VITE_POSTHOG_HOST=
